# Copy to .env and adjust for local development:
#   cp .env.example .env

# Optional: password used by db:seed for demo users
# SEED_USER_PASSWORD=password123

# PostgreSQL (defaults match config/database.yml when unset)
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOST=localhost

# Production database password (production environment only)
HELPDESK_DATABASE_PASSWORD=

# Phase 6 — email notifications
# Development: letter_opener opens mail in the browser unless SENDGRID_API_KEY is set.
MAILER_FROM=helpdesk@localhost
HELPDESK_APP_URL=http://localhost:5173

# Assignment + SLA reminder/breach emails go here when set (plain text).
NOTIFICATION_EMAIL=sakabev418@meonvr.com

# SendGrid (Web API key works as SMTP password; username is always "apikey")
# Verify MAILER_FROM as a Single Sender or domain in SendGrid before sending.
SENDGRID_API_KEY=
# SMTP_DOMAIN=your-verified-domain.com

# Legacy generic SMTP (unused when SENDGRID_API_KEY is set)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Phase 7 — Redis / Sidekiq (optional in dev: without REDIS_URL, jobs use in-process :async)
REDIS_URL=redis://localhost:6379/0

# Phase 9 — Rails.cache (defaults to Redis DB 1; override to isolate from Sidekiq)
# REDIS_CACHE_URL=redis://localhost:6379/1

# Optional basic auth for Sidekiq Web UI (/sidekiq) in non-development
# SIDEKIQ_WEB_USERNAME=admin
# SIDEKIQ_WEB_PASSWORD=changeme

# Local processes (separate terminals when using Sidekiq):
#   redis-server
#   bundle exec sidekiq -C config/sidekiq.yml
#   bundle exec rails s

# Phase 5+ — Attachments (MinIO locally, AWS S3 in cloud)

# Local MinIO (S3-compatible) — https://github.com/minio/minio
# docker run -p 9000:9000 -p 9001:9001 \
#   -e MINIO_ROOT_USER=minioadmin -e MINIO_ROOT_PASSWORD=minioadmin \
#   quay.io/minio/minio server /data --console-address ":9001"
# Console: http://localhost:9001 — then: bundle exec rake storage:ensure_minio_bucket
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=helpdesk
MINIO_REGION=us-east-1

# Production AWS S3 (used when MINIO_* is unset and AWS_* is set)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET=

# Phase 8 — Elasticsearch full-text ticket search (optional; SQL ILIKE fallback when unset or unreachable)
ELASTICSEARCH_URL=http://localhost:9200

# Phase 10 — I18n locales: en (default), es (?locale=es or Accept-Language: es)

# Example: docker run -d --name helpdesk-es -p 9200:9200 -e discovery.type=single-node elasticsearch:7.17.10
# Then: bundle exec rake search:reindex_tickets
